{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmaDeck",
  "version": "0.1.5",
  "identifier": "dev.omadeck.desktop",
  "build": {
    "beforeDevCommand": "python3 -m http.server 1420 --directory ../src/frontend",
    "devUrl": "http://localhost:1420/",
    "frontendDist": "../src/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OmaDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "ios": {
      "infoPlist": "Info.ios.plist",
      "minimumSystemVersion": "15.0"
    }
  }
}
